# Local settings for debug builds: copy to .env (ignored by git). Hermit loads it
# at startup; variables already set in your shell take precedence.

# Send telemetry to Sentry. Without a DSN, debug builds send nothing.
# Settings -> Projects -> <project> -> Client Keys (DSN).
# SENTRY_DSN=https://<key>@<org>.ingest.<region>.sentry.io/<project>

# Stderr log filter.
# RUST_LOG=hermit=debug
