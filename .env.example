# Local settings for debug builds: copy to .env (ignored by git). Hermit loads it
# at startup; variables already set in your shell take precedence.

# Send telemetry to Grafana Cloud instead of the local collector (localhost:4318).
# The header value is base64 of "<instance id>:<token>":
#   printf '%s' '<instance id>:<token>' | base64 -w0
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64>

# Export metrics every 5 s instead of 60 s.
# OTEL_METRIC_EXPORT_INTERVAL=5000

# Stderr log filter.
# RUST_LOG=hermit=debug
